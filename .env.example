# SWEEP configuration. Every variable is optional; the defaults work out of the box.
# Copy to .env to override (docker compose reads it automatically).

# Host port published by docker compose.
SWEEP_PORT=8787
# Session cookies get the Secure flag in production. Keep "false" only for plain-HTTP local use;
# behind HTTPS set it to "true".
COOKIE_SECURE=false
# Trust X-Forwarded-For (only behind your own reverse proxy).
TRUST_PROXY=false
# Hard timeout for one optimisation, in milliseconds.
SWEEP_SOLVER_TIMEOUT_MS=20000
# Map acquisition (OpenStreetMap via the Overpass API). Comma-separated endpoints tried in order;
# the default list is in apps/server/src/config.ts.
# SWEEP_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# Place search (Nominatim, max 1 request/second).
# SWEEP_NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org/search
# Where acquired datasets are cached for 7 days (inside the container: /data/map-cache).
# SWEEP_MAP_CACHE_DIR=data/map-cache
# Set to "off" to disable live map acquisition entirely.
# SWEEP_MAP_ACQUISITION=on
# Behind an HTTP(S) proxy, Node's fetch needs this to use HTTPS_PROXY.
# NODE_USE_ENV_PROXY=1
